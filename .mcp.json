{
  "mcpServers": {
    "codebase-kg": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp",
        "--frozen",
        "--no-dev",
        "codebase-kg"
      ],
      "env": {
        "CODEBASE_KG_PATH": "${CODEBASE_KG_PATH:-}"
      }
    }
  }
}
