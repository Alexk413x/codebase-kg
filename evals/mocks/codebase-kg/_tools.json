{
  "_meta": {
    "io.modelcontextprotocol/serverInfo": {
      "name": "codebase-kg",
      "version": "4.0.3"
    }
  },
  "ttlMs": 0,
  "cacheScope": "private",
  "tools": [
    {
      "name": "kg_search",
      "title": "Kg Search",
      "description": "Full-text search for nodes by concept when you have no node id; the usual\nentry point. Up to 10 ranked results with `path#Symbol` anchors. CamelCase\nnames match in split form.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "Free text, e.g. \"feed ranking\".",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Case-insensitive substring of the node's `kind`."
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_node",
      "title": "Kg Node",
      "description": "Fetch one node by id, with anchors, description, edges, inbound edges,\nlinks and references. An unknown id returns `found: false` and `did_you_mean`.\nNo source text or neighbour details (use `kg_neighborhood`).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Node id.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_neighborhood",
      "title": "Kg Neighborhood",
      "description": "A node with its outbound edges, inbound edges (who depends on it) and\ncounterpart, expanded `depth` hops. Use to see what surrounds a node before\nchanging it. Nearest first, paged by `limit`.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Center node id.",
            "type": "string"
          },
          "depth": {
            "default": 1,
            "description": "Hops, 1 to 3 (others clamped). Depth 3 can reach most of a graph.",
            "type": "integer"
          },
          "limit": {
            "default": 50,
            "description": "Page size.",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "The previous result's `next_offset`.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_find_by_kind",
      "title": "Kg Find By Kind",
      "description": "List every node whose free-text `kind` matches, for a category question such\nas \"every migration\". For a concept or name use `kg_search`: one category can\nbe spelled several ways. Returns id, kind, description and anchors, not edges.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "Case-insensitive substring of `kind`. Empty matches every node.",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Page size.",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "The previous result's `next_offset`.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ]
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_find_by_path",
      "title": "Kg Find By Path",
      "description": "Which node(s) own a source file, and what they connect to. Use when you\nhave a file and want its place in the map.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Repo-relative path, or a bare filename matched as a suffix, e.g. `FeedRanker.kt`.",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Page size.",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "The previous result's `next_offset`.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_find_by_link",
      "title": "Kg Find By Link",
      "description": "Which code node(s) link to a node in another committed graph in this repo,\ntypically a screen in `baselines/baseline.db`. Use when you have a screen\nand want the code behind it.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "description": "A `<db-file>#<node-id>` target, or a bare peer node id.",
            "type": "string"
          }
        },
        "required": [
          "target"
        ]
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_find_by_reference",
      "title": "Kg Find By Reference",
      "description": "Which node(s) depend on a piece of external documentation. Use when an SDK\nor spec changes and you need every place the code relies on it. Each hit has\nthe `path` / `symbol` it narrows to, if any.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Case-insensitive substring of url or title. Omit to list all."
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact tag: `platform-api`, `spec`, `rfc` or `issue`."
          },
          "limit": {
            "default": 50,
            "description": "Page size.",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "The previous result's `next_offset`.",
            "minimum": 0,
            "type": "integer"
          }
        }
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_upsert_node",
      "title": "Kg Upsert Node",
      "description": "Atomic: if any node is rejected nothing is written (`ok: false`,\n`written: false`). Creates or updates nodes for targeted fixes (bulk work:\n`kg_cli.py export`, edit, `build`). Only supplied keys change; `null` clears parity,\ncounterpart and divergence. `anchors`, `edges`, `external_links` and\n`references` replace the whole list, so read the node first to append.\nReturns each row changed, before and after.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodes": {
            "description": "One object per node.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "A new node also needs `kind`.",
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "section": {
                  "type": "string"
                },
                "parity": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "`matched`, `divergent` or `<codebase>-only`."
                },
                "counterpart": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "`<peer-graph-path>#<peer-node-id>`."
                },
                "divergence": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "anchors": {
                  "description": "`[\"path/File.kt#Symbol\"]`: symbols, never line numbers.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "edges": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "external_links": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "target": {
                        "description": "`<peer-db>#<node>`, relative to `knowledge/`.",
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "target"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "references": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "path": {
                        "description": "Must equal an anchor's path.",
                        "type": "string"
                      },
                      "symbol": {
                        "description": "With `path`; must match an anchor.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "rebaseline": {
                  "description": "`true` re-hashes the node's anchored files for every node that anchors them. Set it only after checking all of those nodes.",
                  "type": "boolean"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "nodes"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_delete_node",
      "title": "Kg Delete Node",
      "description": "Delete nodes; previews unless `dry_run=false`. A node's anchors, outbound\nedges and external links go with it. Edges from other nodes into it block the\ndelete unless `cascade_inbound=true`. Rejected whole if it would break the graph.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ids": {
            "description": "Node ids.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "default": true,
            "description": "True previews and writes nothing; pass false to apply.",
            "type": "boolean"
          },
          "cascade_inbound": {
            "default": false,
            "description": "Also remove other nodes' edges into these; otherwise they block the delete.",
            "type": "boolean"
          }
        },
        "required": [
          "ids"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_add_link",
      "title": "Kg Add Link",
      "description": "Point a code node at a node in another committed graph in this repo,\ntypically a screen in `baselines/baseline.db`. Inverse of `kg_find_by_link`.\nRefused if the peer graph is present and lacks that node.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "description": "Code node id.",
            "type": "string"
          },
          "target": {
            "description": "`<db-file>#<node-id>`, relative to `knowledge/`, never absolute.",
            "type": "string"
          },
          "kind": {
            "default": "",
            "description": "E.g. `implements`, `presented-by`, `tests`, `documents`. Empty means unspecified.",
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "target"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_remove_link",
      "title": "Kg Remove Link",
      "description": "Remove one cross-graph link from a node; the node, anchors and edges stay.\nRefused when the node has no link to `target`. Not for a documentation\nreference (`kg_remove_reference`) or an edge between code nodes\n(`kg_upsert_node` with the new `edges`). Returns the change, not the node.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "description": "Code node id.",
            "type": "string"
          },
          "target": {
            "description": "As `kg_node` lists it.",
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "target"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_add_reference",
      "title": "Kg Add Reference",
      "description": "Record where a fact a code node depends on is documented: an API page, spec,\nRFC or issue. Inverse of `kg_find_by_reference`. A `path` / `symbol` that\nmatches none of the node's anchors is refused, so read the node first. Not for\na link to a node in another graph (`kg_add_link`).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "description": "Code node id.",
            "type": "string"
          },
          "url": {
            "description": "Documentation URL.",
            "type": "string"
          },
          "kind": {
            "default": "",
            "description": "`platform-api`, `spec`, `rfc` or `issue`.",
            "type": "string"
          },
          "title": {
            "default": "",
            "description": "Label.",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Must equal the path of one of the node's anchors."
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "With `path`; together they must equal one of the node's anchors."
          }
        },
        "required": [
          "node_id",
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "kg_remove_reference",
      "title": "Kg Remove Reference",
      "description": "Remove a node's references to `url`: all of them, or with `path` / `symbol`\nonly the one with that exact narrowing. Refused when nothing matches. Not for\na link to a node in another graph (`kg_remove_link`). Returns the change, not\nthe node.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "description": "Code node id.",
            "type": "string"
          },
          "url": {
            "description": "As `kg_node` lists it.",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Removes only the reference with exactly this `path` and `symbol`."
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "See `path`."
          }
        },
        "required": [
          "node_id",
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    }
  ],
  "resultType": "complete"
}
