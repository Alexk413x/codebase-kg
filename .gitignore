# Python (MCP server, Phase 2+)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# uv.lock is committed on purpose. Claude Code installs a plugin as a fresh
# clone with no .venv, so without a lock `uv`/`uvx` re-resolves the whole
# dependency set on every MCP server launch (~20s) and trips MCP startup.
.pytest_cache/
.ruff_cache/
build/
dist/

# Per-repo local config — never committed (the .example template IS committed)
.claude/*.local.md
**/codebase-kg.local.md

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# coverage.py artifacts
.coverage
.coverage.*
htmlcov/

# The refresh/audit working file — a snapshot, never an artifact. A stale one
# still parses and silently reverts a later build.
.kg-export.json
