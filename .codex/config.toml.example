# Copy to .codex/config.toml (gitignored) and set the absolute path to your checkout.
# Codex sets CLAUDE_PLUGIN_ROOT for plugin hooks but not for the commands the agent runs,
# and the skills call their scripts through it.
[shell_environment_policy]
inherit = "core"

[shell_environment_policy.set]
CLAUDE_PLUGIN_ROOT = '/absolute/path/to/codebase-kg'
