#!/bin/sh
# codebase-kg staleness check over the staged change set.
#
# ADVISORY: it reports and never blocks. A gate that stops a commit gets
# bypassed with --no-verify and then ignored. The pre-push hook beside it does
# block, on one thing only: any mapped file the graph no longer matches.
# A commit is provisional; a push is publication.
#
# It does NOT run /codebase-kg:refresh. That is a model workflow -- it maps
# changed files to nodes and decides what to add, edit or remove -- and a shell
# hook cannot make those calls. This says the graph needs attention; a person
# or an agent still does the refreshing.
#
# Skip: SKIP_KG=1 git commit ...     (or --no-verify to skip every hook)
[ -n "$SKIP_KG" ] && exit 0
DIR=$(dirname "$0")
# python3 can be a Microsoft Store stub on Windows, so the py launcher goes first
# and each candidate must run.
PY=
for candidate in "py -3" python3 python; do
  if $candidate -c "" </dev/null >/dev/null 2>&1; then PY=$candidate; break; fi
done
[ -n "$PY" ] || exit 0
$PY "$DIR/kg_pre_commit.py" || true
