#!/bin/sh
# codebase-kg pre-push staleness check — reports when the commits you're pushing
# add source no node covers, or delete source the graph still anchors on.
#
# ADVISORY: it never blocks. There is nothing to override.
#
# Vendored: keep kg_pre_push.py next to this file. If this repo already has a
# pre-push hook, DON'T overwrite it — add the two lines below to it instead.
#
# NOTE: git feeds the pushed refs on this hook's stdin; kg_pre_push.py reads
# them to check exactly the pushed commits. Keep this call first — before
# anything else that might consume stdin.
DIR=$(dirname "$0")
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
"$PY" "$DIR/kg_pre_push.py" || true
