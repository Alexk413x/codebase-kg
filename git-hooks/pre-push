#!/bin/sh
# codebase-kg pre-push staleness check — reports when the commits you're pushing
# add source no node covers, or delete source the graph still anchors on, and
# checks the whole repo against the graph.
#
# It blocks on ONE thing: any mapped file whose contents no longer match the
# graph, including files this push touches. Everything scoped to the pushed
# commits stays advisory, and an error in the checker itself always exits 0.
# Release a block with KG_STALE_ACK=<count> (the total stale count is in the
# message), SKIP_KG=1, or git push --no-verify.
#
# To clear a block, run /codebase-kg:refresh, commit the graph and push again.
#
# The exit status is deliberately NOT swallowed with `|| true` — that is what
# makes the gate a gate. kg_pre_push.py returns non-zero only for unacknowledged
# stale mapped files; it catches its own errors and returns 0.
#
# Vendored: keep kg_pre_push.py next to this file. If this repo already has a
# pre-push hook, DON'T overwrite it — add the lines below to it instead.
#
# NOTE: git feeds the pushed refs on this hook's stdin; kg_pre_push.py reads
# them to check exactly the pushed commits. Keep this call first — before
# anything else that might consume stdin.
DIR=$(dirname "$0")
[ -f "$DIR/kg_pre_push.py" ] || exit 0
# Resolved rather than assumed: with the status no longer swallowed, a missing
# interpreter would exit 127 and block every push in a repo that cannot run the
# check at all. Each candidate must run: on Windows, python3 can be a Microsoft
# Store stub that exists on PATH and fails when called, so the py launcher is
# tried first.
PY=
for candidate in "py -3" python3 python; do
  if $candidate -c "" </dev/null >/dev/null 2>&1; then PY=$candidate; break; fi
done
[ -n "$PY" ] || exit 0
$PY "$DIR/kg_pre_push.py"
